---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SearchModal from './SearchModal.astro';
import { Icon } from 'astro-icon/components';
---
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PM45PKZC"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<header class="site-header">
	<div class="header-inner">
		<h2>
			<a href="/" style="display: flex; align-items: center; text-decoration: none;">
				<div class="logo-box">
					<img src="/brand/qaaix_logo.png" alt="QAAIX" class="logo-img" />
				</div>
				<span class="sr-only">{SITE_TITLE}</span>
			</a>
		</h2>
		
		<div class="header-right">
			<nav id="nav-menu">
				<div class="internal-links">
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href="/category/">Category</HeaderLink>
					<HeaderLink href="/about/">About</HeaderLink>
					<HeaderLink href="/contact/">Contact</HeaderLink>
				</div>
			</nav>

			<button type="button" class="search-trigger-btn header-search-btn" aria-label="サイト内検索" title="検索 (Cmd+K / Ctrl+K)">
				<Icon name="heroicons:magnifying-glass" class="search-btn-icon" />
				<span class="search-btn-label">検索</span>
				<span class="search-btn-kbd"><kbd>⌘K</kbd></span>
			</button>

			<button id="menu-btn" class="hamburger-btn" aria-label="Menu">
				<span class="hamburger-line"></span>
				<span class="hamburger-line"></span>
				<span class="hamburger-line"></span>
			</button>
		</div>
	</div>
</header>
<SearchModal />

<script>
	// Hamburger menu toggle logic
	const menuBtn = document.getElementById('menu-btn');
	const navMenu = document.getElementById('nav-menu');
	
	if (menuBtn && navMenu) {
		menuBtn.addEventListener('click', () => {
			navMenu.classList.toggle('active');
			menuBtn.classList.toggle('open');
		});
	}
</script>

<style>
	.site-header {
		background-color: #05070f;
		border-bottom: 1px solid #1e293b;
		margin: 0;
		position: sticky;
		top: 0;
		z-index: 1000;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
	}
	.header-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.5em 1em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		position: relative;
	}
	h2 {
		margin: 0;
		font-size: 1.4em;
	}
	h2 a {
		color: #ffffff;
		text-decoration: none;
	}
	.logo-box {
		background: transparent;
		padding: 2px 0;
		display: flex;
		align-items: center;
		transition: transform 0.2s ease, filter 0.2s ease;
	}
	.logo-box:hover {
		transform: translateY(-1px);
		filter: drop-shadow(0 0 10px rgba(26, 109, 255, 0.6));
	}
	.logo-img {
		height: 36px;
		width: auto;
		display: block;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	nav {
		display: flex;
		align-items: center;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1em;
	}
	nav a {
		padding: 0.5em 0.6em;
		color: #cbd5e1;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95em;
		transition: color 0.2s ease;
	}
	nav a:hover {
		color: #ffffff;
		opacity: 1;
	}
	nav a.active {
		color: #ffffff;
		border-bottom: 2px solid var(--theme-accent, #1a6dff);
		text-decoration: none;
	}

	/* Search Button */
	.header-search-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.65rem;
		background-color: #1e293b;
		border: 1px solid #334155;
		border-radius: 20px;
		color: #94a3b8;
		font-size: 0.85rem;
		cursor: pointer;
		transition: all 0.2s ease;
		font-family: inherit;
		line-height: 1;
	}
	.header-search-btn:hover {
		border-color: var(--theme-accent, #1a6dff);
		color: #ffffff;
		background-color: #0f172a;
	}
	.search-btn-icon {
		font-size: 1.1rem;
		flex-shrink: 0;
	}
	.search-btn-kbd {
		display: inline-flex;
		align-items: center;
	}
	.search-btn-kbd kbd {
		background-color: #0f172a;
		border: 1px solid #334155;
		color: #94a3b8;
		padding: 0.05rem 0.3rem;
		border-radius: 3px;
		font-size: 0.7rem;
		box-shadow: 0 1px 0 rgba(0,0,0,0.3);
	}
	
	/* Hamburger Button Hidden on PC */
	.hamburger-btn {
		display: none;
		flex-direction: column;
		justify-content: space-between;
		width: 24px;
		height: 18px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 1001;
	}
	.hamburger-line {
		display: block;
		height: 2px;
		width: 100%;
		background-color: #f8fafc;
		transition: all 0.3s ease;
	}

	@media (max-width: 720px) {
		.hamburger-btn {
			display: flex;
		}

		.header-search-btn {
			padding: 0.4rem;
			border-radius: 50%;
			background: none;
			border: none;
			color: #cbd5e1;
		}
		.header-search-btn:hover {
			background-color: #1e293b;
		}
		.search-btn-icon {
			font-size: 1.3rem;
		}
		.search-btn-label,
		.search-btn-kbd {
			display: none;
		}
		
		nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			width: 100%;
			background-color: #05070f;
			border-bottom: 1px solid #1e293b;
			box-shadow: 0 8px 16px rgba(0,0,0,0.5);
		}
		nav.active {
			display: block;
		}
		.internal-links {
			flex-direction: column;
			gap: 0;
			text-align: center;
		}
		.internal-links a {
			padding: 1rem;
			width: 100%;
			border-top: 1px solid #1e293b;
			color: #cbd5e1;
		}
		.internal-links a:hover {
			color: #ffffff;
			background-color: rgba(255, 255, 255, 0.05);
		}
		
		/* Hamburger animation */
		.hamburger-btn.open .hamburger-line:nth-child(1) {
			transform: translateY(8px) rotate(45deg);
		}
		.hamburger-btn.open .hamburger-line:nth-child(2) {
			opacity: 0;
		}
		.hamburger-btn.open .hamburger-line:nth-child(3) {
			transform: translateY(-8px) rotate(-45deg);
		}
	}
</style>