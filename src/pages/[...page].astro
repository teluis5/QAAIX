---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths({ paginate }) {
	const allPosts = await getCollection('blog');
	const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return paginate(sortedPosts, { pageSize: 10 });
}

const { page } = Astro.props;

// サイドバーの新着記事用に全記事を取得
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.entry-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				list-style: none;
				padding: 0;
				margin: 0 0 2rem 0;
			}
			.entry-card {
				display: flex;
				background-color: var(--bg-content);
				border: 1px solid var(--border-color);
				border-radius: var(--radius);
				overflow: hidden;
				text-decoration: none;
				color: var(--text-main);
				transition: background-color 0.2s;
			}
			.entry-card:hover {
				background-color: #fafafa;
				text-decoration: none;
			}
			.entry-thumb {
				flex: 0 0 300px;
				aspect-ratio: 16/9;
				overflow: hidden;
				background-color: var(--border-color);
			}
			.entry-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.entry-content {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.entry-title {
				font-size: 1.25rem;
				margin: 0 0 0.5rem 0;
				line-height: 1.4;
			}
			.entry-date {
				font-size: 0.9rem;
				color: var(--text-light);
				margin: 0;
			}
			
			/* Sidebar Widgets */
			.widget {
				padding: 1.5rem;
				margin-bottom: 2rem;
			}
			.widget-title {
				font-size: 1.1rem;
				color: var(--text-main);
				background-color: #f7f7f7;
				padding: 0.5rem 1rem;
				border-left: 4px solid var(--theme-accent);
				margin: -1.5rem -1.5rem 1.5rem -1.5rem;
			}

			/* Pagination */
			.pagination {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 2rem;
				padding-top: 1rem;
				border-top: 1px solid var(--border-color);
			}
			.page-link {
				padding: 0.5rem 1rem;
				background-color: var(--theme-accent);
				color: white;
				border-radius: 4px;
				text-decoration: none;
				font-weight: bold;
			}
			.page-link:hover {
				opacity: 0.8;
				text-decoration: none;
			}
			.page-current {
				font-size: 0.9rem;
				color: var(--text-light);
			}
			
			@media (max-width: 720px) {
				.entry-list {
					gap: 0.6rem;
				}
				.entry-card {
					flex-direction: row;
					align-items: stretch;
				}
				.entry-thumb {
					flex: 0 0 110px;
					width: 110px;
					aspect-ratio: 16 / 9;
					min-height: 70px;
				}
				.entry-content {
					padding: 0.6rem 0.75rem;
					flex: 1;
					min-width: 0;
					justify-content: space-between;
				}
				.entry-title {
					font-size: 0.92rem;
					margin: 0 0 0.25rem 0;
					line-height: 1.35;
					display: -webkit-box;
					-webkit-box-orient: vertical;
					-webkit-line-clamp: 2;
					overflow: hidden;
				}
				.entry-date {
					font-size: 0.75rem;
				}
			}

			/* ヒーローバナー */
			.hero-banner {
				width: 100%;
				max-width: 1200px;
				margin: 0 auto;
				padding: 1rem 1rem 0;
			}
			.hero-card {
				background: linear-gradient(135deg, #05070f 0%, #0f172a 100%);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 12px;
				padding: 2.5rem 1.5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
			}
			.hero-logo {
				max-width: 320px;
				width: 80%;
				height: auto;
				filter: drop-shadow(0 0 20px rgba(0, 102, 255, 0.45));
				margin-bottom: 0.8rem;
			}
			.hero-tagline {
				color: #94a3b8;
				font-size: 0.95rem;
				letter-spacing: 0.05em;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		
		<!-- トップヒーローバナー -->
		{page.currentPage === 1 && (
			<div class="hero-banner">
				<div class="hero-card">
					<img src="/brand/qaaix_logo.png" alt="QAAIX Logo" class="hero-logo" />
					<p class="hero-tagline">Quality Assurance &amp; AI-Driven Test Automation Media</p>
				</div>
			</div>
		)}

		<main>
			<div class="layout-container">
				<!-- メインコンテンツ (左カラム) -->
				<div class="layout-main">
					<div class="entry-list">
						{
							page.data.map((post) => (
								<a href={`/blog/${post.id}/`} class="entry-card box">
									<div class="entry-thumb">
										{post.data.heroImage ? (
											<Image width={720} height={405} src={post.data.heroImage} alt="" />
										) : (
											<div style="width:100%; height:100%; background:#e0e0e0;"></div>
										)}
									</div>
									<div class="entry-content">
										<h2 class="entry-title">{post.data.title}</h2>
										<p class="entry-date">
											<Icon name="heroicons:calendar" class="icon-inline" /> <FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							))
						}
					</div>

					<!-- ページネーション -->
					{page.lastPage > 1 && (
						<div class="pagination">
							{page.url.prev ? <a href={page.url.prev} class="page-link">&laquo; 前へ</a> : <div></div>}
							<span class="page-current">{page.currentPage} / {page.lastPage} ページ</span>
							{page.url.next ? <a href={page.url.next} class="page-link">次へ &raquo;</a> : <div></div>}
						</div>
					)}
				</div>

				<!-- サイドバー (右カラム) -->
				<aside class="layout-sidebar">
					<div class="widget box">
						<div class="widget-title"><Icon name="heroicons:user" class="icon-inline" /> プロフィール</div>
						<img class="profile-pic" src="/brand/qaaix_symbol.png" alt="QAAIX" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; background-color: #000; display: block; object-fit: cover; border: 2px solid var(--theme-accent);" />
						<p class="profile-desc" style="font-size: 0.9rem; color: var(--text-main); text-align: left; line-height: 1.6;">
							<strong>QAエンジニア / SET</strong><br/>
							テスト自動化、TDD、CI/CDテスト基盤構築や品質保証の現場で得た泥臭い実践知とアーキテクチャ設計を発信しています。
						</p>
					</div>

					

					<div class="widget box">
						<div class="widget-title"><Icon name="heroicons:sparkles" class="icon-inline" /> 新着記事</div>
						<ul style="list-style:none; padding:0; margin:0; font-size:0.95em;">
							{sortedPosts.slice(0, 5).map((post) => (
								<li style="border-bottom: 1px dashed var(--border-color); padding: 0.5rem 0;">
									<a href={`/blog/${post.id}/`} style="color:var(--text-main);">{post.data.title}</a>
								</li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
